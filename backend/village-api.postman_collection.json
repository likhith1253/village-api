		{
			"name": "API Key Management",
			"item": [
				{
					"name": "Create API Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const responseJson = pm.response.json();",
									"if (responseJson && responseJson.data) {",
									"    pm.collectionVariables.set(\"apiKeyId\", responseJson.data.id);",
									"    pm.collectionVariables.set(\"apiKeyValue\", responseJson.data.key);",
									"    console.log(\"Saved apiKeyId and apiKeyValue!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
