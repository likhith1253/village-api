# Copy to backend/.env (never commit the real file).

# --- Required -------------------------------------------------------------
# PostgreSQL connection string (Neon, local Docker, ...)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Random secret, at least 32 characters. The server refuses to start otherwise.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# --- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV="development"

# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Set to the number of reverse proxies in front of the API (e.g. 1) so req.ip is the real client IP.
# Used by the login/register rate limiter.
# TRUST_PROXY=1

# --- Rate limiting --------------------------------------------------------
# Daily request quota for FREE plan users (default 100; PRO is fixed at 10000)
RATE_LIMIT_FREE="100"
# Max login/register/demo-login attempts per IP per 15 minutes (default 20)
# AUTH_RATE_LIMIT_MAX="20"

# --- Stripe (optional; billing endpoints return 503 when unset) -----------
STRIPE_SECRET_KEY="sk_test_..."
# Required for POST /api/billing/webhook; the endpoint refuses unsigned events and is disabled without it
STRIPE_WEBHOOK_SECRET="whsec_..."
FRONTEND_URL="http://localhost:5173"

# --- Upstash Redis (optional; falls back to a per-process in-memory cache) -
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Scripts only ---------------------------------------------------------
# Directory containing Rdir_2011_*.xls (default: backend/data/dataset, see `npm run data:extract`)
# DATASET_DIR=""
# Password for `npm run seed:demo` (min 8 chars)
# DEMO_USER_PASSWORD=""
